# Core retrieval environment
S2CS_MILVUS_URI=http://127.0.0.1:19530
S2CS_PAPERS_DB=data/processed/papers.duckdb
S2CS_EDGES_PATH=data/processed/edges.parquet
S2CS_MODEL=BAAI/bge-m3
S2CS_DEVICES=cuda:0

