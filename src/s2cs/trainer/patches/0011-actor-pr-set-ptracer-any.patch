+            _libc = _ctypes.CDLL("libc.so.6", use_errno=True)
+            _PR_SET_PTRACER = 0x59616D61
+            _PR_SET_PTRACER_ANY = _ctypes.c_ulong(0xFFFFFFFFFFFFFFFF)
+            _libc.prctl(_PR_SET_PTRACER, _PR_SET_PTRACER_ANY, _ctypes.c_ulong(0), _ctypes.c_ulong(0), _ctypes.c_ulong(0))
+        except Exception:
