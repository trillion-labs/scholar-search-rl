+class ProjZModule(torch.nn.Module):
+    """SEAL separation head: projects an actor hidden state to a scalar logit.
+
+    Attached to the actor before FSDP wrap so its params are sharded + optimized.
+    Output (…, 1) feeds the per-token correct/incorrect BCE in
+    ``core_algos.seal_classification_loss``.
+    """
+
+    def __init__(self, hidden_size: int, num_layers: int = 3, dropout: float = 0.1):
+        super().__init__()
+        layers = []
+        for _ in range(num_layers - 1):
+            layers += [
+                torch.nn.Linear(hidden_size, hidden_size),
+                torch.nn.GELU(),
+                torch.nn.LayerNorm(hidden_size),
+                torch.nn.Dropout(dropout),
+            ]
+        layers.append(torch.nn.Linear(hidden_size, 1))
+        self.net = torch.nn.Sequential(*layers)
+
+    def forward(self, x):
+        return self.net(x)
+
